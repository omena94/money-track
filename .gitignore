# Root allowlist: new top-level content requires an explicit review.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CONTRIBUTING.md
!/SECURITY.md
!/package.json
!/package-lock.json
!/Cargo.toml
!/Cargo.lock
!/apps/
!/docs/
!/scripts/

# Dependencies and generated output.
node_modules/
.next/
target/
.venv/
__pycache__/
*.py[cod]
dist/
coverage/
*.log
*.tsbuildinfo
playwright-report/
test-results/

# Secrets, private research, local state and financial exports (including encrypted ones).
.local/
.env*
!.env.example
*.dpapi
*.mtbackup
*.pem
*.key
*.p12
*.pfx
*.har
*.dump
*.db
*.sqlite*
*.bak
*.backup
*.zip
*.7z
*.apk
*.aab
*.dex
*.jks
*.keystore
android-tools/
research/
private/
backups/
screenshots/
all-set-tw/

# Installed bank artwork stays available locally; redistribution rights not established.
/apps/web/public/banks/*.png

# One-off account maintenance and personal deployment tools are not public sources.
/apps/api/examples/*
!/apps/api/examples/openapi.rs
!/apps/api/examples/ui_fixture.rs
/scripts/Configure-Tunnel.ps1
/scripts/*research*
/scripts/*probe*
/scripts/hsbc_*.py
/scripts/diagnose_hsbc_login_ui.py
/scripts/verify_hsbc*
/scripts/oauth_local_setup.py
/scripts/vendor-connectors.py
